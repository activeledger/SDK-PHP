{
    "name": "activeledger/sdk",
    "type": "library",
    "description": "PHP SDK for Activeledger, with post-quantum identity support (ML-DSA-65)",
    "keywords": [
        "activeledger", "sdk", "blockchain", "dlt",
        "distributed ledger technology", "ledger", "smart contracts",
        "post-quantum", "ml-dsa"
    ],
    "homepage": "https://www.activeledger.io",
    "license": "MIT",
    "authors": [
        { "name": "Activeledger" }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "paragonie/pqcrypto_compat": "^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-pqcrypto": "Faster ML-DSA signing; pqcrypto_compat uses it automatically when present"
    },
    "autoload": {
        "psr-4": { "Activeledger\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Activeledger\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
